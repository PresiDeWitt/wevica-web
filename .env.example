# Google Analytics 4 — measurement ID (public, safe to expose in client)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Número de tiendas activas (mostrado en landing page)
NEXT_PUBLIC_ACTIVE_STORES=20

# Lemon Squeezy checkout URLs para Sync Engine
# Obtén los IDs de tus productos en: https://app.lemonsqueezy.com/products
NEXT_PUBLIC_LS_SE_STARTER=https://stocksyncpro.lemonsqueezy.com/buy/TODO_SE_STARTER_MONTHLY
NEXT_PUBLIC_LS_SE_PRO=https://stocksyncpro.lemonsqueezy.com/buy/TODO_SE_PRO_MONTHLY
NEXT_PUBLIC_LS_SE_BUSINESS=https://stocksyncpro.lemonsqueezy.com/buy/TODO_SE_BUSINESS_MONTHLY

# Lemon Squeezy checkout URLs para planes Plugin
NEXT_PUBLIC_LS_PLUGIN_BUSINESS_ANNUAL=https://stocksyncpro.lemonsqueezy.com/buy/TODO_PLUGIN_BUSINESS_ANNUAL
NEXT_PUBLIC_LS_PLUGIN_BUSINESS_MONTHLY=https://stocksyncpro.lemonsqueezy.com/buy/TODO_PLUGIN_BUSINESS_MONTHLY
NEXT_PUBLIC_LS_PLUGIN_AGENCY_ANNUAL=https://stocksyncpro.lemonsqueezy.com/buy/TODO_PLUGIN_AGENCY_ANNUAL
NEXT_PUBLIC_LS_PLUGIN_AGENCY_MONTHLY=https://stocksyncpro.lemonsqueezy.com/buy/TODO_PLUGIN_AGENCY_MONTHLY

# Resend — for newsletter subscriber notifications
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXX

# Email address to receive subscriber notifications (default: hola@wevica.com)
NOTIFY_EMAIL=hola@wevica.com

# Crisp chat widget ID
# Get it at: https://app.crisp.chat → Settings → Website Settings
CRISP_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Upstash Redis — rate limiting on /api/subscribe (5 req/IP/hour)
# Get your credentials at: https://upstash.com
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx
